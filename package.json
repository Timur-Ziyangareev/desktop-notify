{
  "name": "@local/desktop-notify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Desktop notifications with a sound cue when a DSH turn finishes, needs the user, or fails.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
