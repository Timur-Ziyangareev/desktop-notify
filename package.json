{
  "name": "@local/desktop-notify",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Desktop notifications with a sound cue when a DSH turn finishes, needs the user, or fails.",
  "license": "MIT",
  "author": "Timur Ziyangareev <timurziangareev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Timur-Ziyangareev/desktop-notify.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "notifications",
    "toast",
    "windows"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
